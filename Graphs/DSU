struct DSU {
  int n, Ncmp;
  vector<int> p;

  DSU(int _n): n(_n), Ncmp(_n), p(_n, -1) {}

  int operator [](int u) {
    return p[u] < 0 ? u : p[u] = (*this)[p[u]];
  }

  int operator ()(int u, int v) {
    u = (*this)[u], v = (*this)[v];
    if (u == v) {
      return 0;
    }
    if (p[u] > p[v]) {
      swap(u, v);
    }
    p[u] += p[v];
    p[v] = u;
    Ncmp--;
    return 1;
  }

  int size(int u) {
    return -p[(*this)[u]];
  }
};
