struct Parallel_DSU {

  int n;
  vector<DSU> dsu;

  Parallel_DSU(int _n): n(_n) {
    for (int i = 0; (1 << i) <= n; ++i) {
      dsu.push_back(DSU(n - (1 << i) + 1));
    }
  }

  void operator ()(int u, int v, int len) {
    while (len) {
      int pw = len & -len;
      dsu[__lg(pw)](u, v);
      len -= pw;
      u += pw;
      v += pw;
    }
  }

  DSU* calculate() {
    for (int i = (int)dsu.size() - 1; i; --i) {
      int m = dsu[i].n;
      vector<int> last(m, -1);
      for (int j = 0; j < m; ++j) {
        int leader = dsu[i][j];
        if (last[leader] != -1) {
          dsu[i - 1](last[leader], j);
          dsu[i - 1](last[leader] + (1 << (i - 1)), j + (1 << (i - 1)));
        }
        last[leader] = j;
      }
    }
    return &dsu[0];
  }
};
