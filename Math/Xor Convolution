void fwht(vector<int64_t> &a, bool inverse) {
  int n = a.size();
  for (int len = 1; len < n; len <<= 1) {
    for (int i = 0; i < n; i += 2 * len) {
      for (int j = i; j < i + len; ++j) {
        int64_t u = a[j], v = a[j + len];
        a[j] = u + v;
        a[j + len] = u - v;
      }
    }
  }
  if (inverse) {
    for (auto &x : a) {
      x /= n;
    }
  }
}

void XorConvolution(vector<int64_t> &a, vector<int64_t> &b, vector<int64_t> &c) {
  assert(!a.empty());
  assert(a.size() == b.size());
  assert((a.size() & (a.size() - 1)) == 0);

  vector<int64_t> bb = b;
  c = a;
  fwht(c, false);
  fwht(bb, false);
  for (size_t i = 0; i < c.size(); ++i) {
    c[i] *= bb[i];
  }
  fwht(c, true);
}

