template <class T = string> 
vector<vector<int>> kmp(const T &s){
  int n = s.size();
  vector<int> fail(n);
  vector<vector<int>> ans(n + 1, vector<int>(26, 0));
  ans[0][s[0] - 'a'] = 1;
  fail[0] = 0;
  int len = 0;
  for (int i = 1; i < n; ++i) {
    len = fail[i - 1];
    while (len && s[len] != s[i]) {
      len = fail[len - 1];
    }
    fail[i] = len + (s[len] == s[i]);
  }
  for (int i = 0; i <= n; ++i) {
    for (int c = 0; c < 26; ++c) {
      if (i < n && s[i] - 'a' == c) {
        ans[i][c] = i + 1;
      } else {
        ans[i][c] = i ? ans[fail[i - 1]][c] : 0;
      }
    }
  }
  return ans;
}
