template <class T = string> 
vector<vector<int>> kmp (const T &s){
  int n = s.size();
  vector<int> fail(n);
  vector<vector<int>> ans(n + 1, vector<int>(26, 0));
  ans[0][s[0] - 'a'] = 1;
  fail[0] = 0;
  int len = 0;
  for (int i = 1; i < n; ++i) {
    len = fail[i - 1];
    while (len && s[len] != s[i]) {
      len = fail[len - 1];
    }
    fail[i] = len + (s[len] == s[i]);
  }
  for (int i = 1; i <= n; i++) {
    for (int j = 0; j < 26; j++) {
      char c = 'a' + j;
      int len = i == n ? fail[i - 1] : i;
      while (len && c != s[len]) {
        len = fail[len - 1];
      }
      ans[i][j] = len + (c == s[len]);
    }
  }
  return ans;
}
